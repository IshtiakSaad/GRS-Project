# Bangla messages for the API. Bangla is the default language (Accept-Language: bn).
# Plain words, short sentences: many users read with difficulty.
msgid ""
msgstr ""
"Project-Id-Version: grs\n"
"PO-Revision-Date: 2026-09-28 00:00+0600\n"
"Last-Translator: GRS maintainers\n"
"Language-Team: Bangla\n"
"Language: bn\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Your session has expired. Please log in again."
msgstr "আপনার সেশনের মেয়াদ শেষ। আবার লগইন করুন।"

msgid "Phone number or password is incorrect."
msgstr "ফোন নম্বর বা পাসওয়ার্ড সঠিক নয়।"

msgid "The code is incorrect or has expired."
msgstr "কোডটি সঠিক নয় অথবা মেয়াদ শেষ।"

msgid "Too many failed attempts. Try again in %(minutes)s minutes."
msgstr "অনেকবার ভুল হয়েছে। %(minutes)s মিনিট পরে আবার চেষ্টা করুন।"

msgid "Some fields are invalid."
msgstr "কিছু তথ্য সঠিক নয়।"

msgid "Your login has expired. Please log in again."
msgstr "লগইনের মেয়াদ শেষ। আবার লগইন করুন।"

msgid "Two-step login is already on."
msgstr "দুই ধাপের লগইন আগে থেকেই চালু আছে।"

msgid "Current password is incorrect."
msgstr "বর্তমান পাসওয়ার্ড সঠিক নয়।"

msgid "This email is used by another account."
msgstr "এই ইমেইল অন্য একটি অ্যাকাউন্টে ব্যবহৃত হচ্ছে।"

msgid "If the number can receive it, a code has been sent by SMS."
msgstr "নম্বরটি সঠিক হলে এসএমএসে একটি কোড পাঠানো হয়েছে।"

msgid "Not found."
msgstr "পাওয়া যায়নি।"

msgid "Something went wrong. Please try again."
msgstr "একটি সমস্যা হয়েছে। আবার চেষ্টা করুন।"

msgid "Enter a Bangladeshi mobile number, for example 01712345678."
msgstr "বাংলাদেশি মোবাইল নম্বর লিখুন, যেমন 01712345678।"

msgid "A submitted request can no longer be edited or deleted."
msgstr "জমা দেওয়া আবেদন আর সম্পাদনা বা মুছে ফেলা যায় না।"

msgid "Choose a service from the list."
msgstr "তালিকা থেকে একটি সেবা বেছে নিন।"

msgid "Choose an active officer of this request's department."
msgstr "এই আবেদনের বিভাগের একজন সক্রিয় কর্মকর্তা বেছে নিন।"

msgid "Information was already requested twice. An administrator must review this."
msgstr "ইতিমধ্যে দুইবার তথ্য চাওয়া হয়েছে। একজন প্রশাসককে বিষয়টি দেখতে হবে।"

msgid "Reload the request and send its ETag as If-Match."
msgstr "আবেদনটি আবার লোড করুন এবং এর ETag If-Match হিসেবে পাঠান।"

msgid "Say why the request is urgent."
msgstr "আবেদনটি কেন জরুরি তা লিখুন।"

msgid "Send an Idempotency-Key header of 8 to 64 letters, digits, - or _."
msgstr "৮ থেকে ৬৪ অক্ষরের (অক্ষর, সংখ্যা, - বা _) একটি Idempotency-Key হেডার পাঠান।"

msgid "Someone else changed this request. Reload it and try again."
msgstr "অন্য কেউ আবেদনটি পরিবর্তন করেছেন। আবার লোড করে চেষ্টা করুন।"

msgid "Submit or delete some of your drafts first."
msgstr "আগে আপনার কিছু খসড়া জমা দিন বা মুছে ফেলুন।"

msgid "The request is already assigned to this officer."
msgstr "আবেদনটি ইতিমধ্যে এই কর্মকর্তাকে দেওয়া আছে।"

msgid "The time to reopen this request has passed."
msgstr "এই আবেদন পুনরায় খোলার সময় পার হয়ে গেছে।"

msgid "This Idempotency-Key was already used for a different request."
msgstr "এই Idempotency-Key অন্য একটি অনুরোধে ব্যবহার করা হয়েছে।"

msgid "This cannot be done while the request is in this state."
msgstr "আবেদনের বর্তমান অবস্থায় এটি করা যায় না।"

msgid "This request cannot be reopened again."
msgstr "এই আবেদন আর পুনরায় খোলা যাবে না।"

msgid "This service is no longer offered."
msgstr "এই সেবাটি আর দেওয়া হয় না।"

msgid "This tracking number is not valid. Check it and try again."
msgstr "ট্র্যাকিং নম্বরটি সঠিক নয়। মিলিয়ে দেখে আবার চেষ্টা করুন।"

msgid "Unknown status."
msgstr "অজানা অবস্থা।"

msgid "Verify your phone number to submit more than one request."
msgstr "একাধিক আবেদন জমা দিতে আপনার ফোন নম্বর যাচাই করুন।"

msgid "You are not allowed to do this with this request."
msgstr "এই আবেদনে আপনি এটি করতে পারেন না।"

msgid "You submitted the same request a few minutes ago."
msgstr "কয়েক মিনিট আগে আপনি একই আবেদন জমা দিয়েছেন।"

msgid "A category's department never changes."
msgstr "কোনো সেবার বিভাগ কখনো বদলায় না।"

msgid "A suspension is at most a year."
msgstr "স্থগিতের মেয়াদ সর্বোচ্চ এক বছর।"

msgid "At most 400 days at a time."
msgstr "একবারে সর্বোচ্চ ৪০০ দিন।"

msgid "Choose a period of at most 400 days, date_from before date_to."
msgstr "সর্বোচ্চ ৪০০ দিনের সময়কাল বেছে নিন; date_from যেন date_to-এর আগে হয়।"

msgid "Choose an existing department."
msgstr "একটি বিদ্যমান বিভাগ বেছে নিন।"

msgid "Citizens reset their own password, or at a help desk with their ID."
msgstr "নাগরিক নিজেই পাসওয়ার্ড রিসেট করবেন, অথবা পরিচয়পত্র নিয়ে হেল্প ডেস্কে।"

msgid "Enter a year, e.g. 2026."
msgstr "একটি বছর লিখুন, যেমন ২০২৬।"

msgid "Files can be at most 10 MB."
msgstr "ফাইল সর্বোচ্চ ১০ MB হতে পারে।"

msgid "Must not be before date_from."
msgstr "date_from-এর আগে হতে পারবে না।"

msgid "Must not be before starts_on."
msgstr "starts_on-এর আগে হতে পারবে না।"

msgid "Only officers belong to a department."
msgstr "শুধু কর্মকর্তারাই কোনো বিভাগের অধীন।"

msgid "Only staff can write internal comments."
msgstr "শুধু কর্মীরাই অভ্যন্তরীণ মন্তব্য লিখতে পারেন।"

msgid "Submit the request before commenting."
msgstr "মন্তব্য করার আগে আবেদনটি জমা দিন।"

msgid "This code is already used."
msgstr "এই কোড ইতিমধ্যে ব্যবহৃত।"

msgid "This date is already a holiday."
msgstr "এই তারিখ ইতিমধ্যে ছুটির দিন।"

msgid "This department is not active."
msgstr "এই বিভাগটি সক্রিয় নয়।"

msgid "This file is not available."
msgstr "এই ফাইলটি পাওয়া যাচ্ছে না।"

msgid "This file was rejected."
msgstr "এই ফাইলটি গ্রহণ করা হয়নি।"

msgid "This phone number already has an account."
msgstr "এই ফোন নম্বরে ইতিমধ্যে একটি অ্যাকাউন্ট আছে।"

msgid "This request already has the most files allowed."
msgstr "এই আবেদনে সর্বোচ্চ সংখ্যক ফাইল ইতিমধ্যে যুক্ত আছে।"

msgid "This request is closed."
msgstr "এই আবেদনটি বন্ধ হয়ে গেছে।"

msgid "Upload a PDF, JPEG or PNG file."
msgstr "PDF, JPEG বা PNG ফাইল আপলোড করুন।"

msgid "You cannot deactivate your own account."
msgstr "আপনি নিজের অ্যাকাউন্ট নিষ্ক্রিয় করতে পারবেন না।"

msgid "Choose between 1 and 366 days."
msgstr "১ থেকে ৩৬৬ দিনের মধ্যে বেছে নিন।"

msgid "Explain the reason in at least 20 characters."
msgstr "কারণটি অন্তত ২০ অক্ষরে লিখুন।"

msgid "Only the citizen and auditors see this log."
msgstr "এই লগ শুধু নাগরিক ও নিরীক্ষকরা দেখতে পারেন।"

#, python-format
msgid "Too many requests. Try again in %(seconds)s seconds."
msgstr "অনেক বেশি অনুরোধ। %(seconds)s সেকেন্ড পরে আবার চেষ্টা করুন।"

msgid "This review has already been decided."
msgstr "এই পর্যালোচনার সিদ্ধান্ত আগেই হয়ে গেছে।"

msgid "You cannot review your own decision."
msgstr "নিজের সিদ্ধান্ত নিজে পর্যালোচনা করা যায় না।"

msgid "The request has changed since this decision; uphold or look again."
msgstr "এই সিদ্ধান্তের পর আবেদনটি বদলেছে; বহাল রাখুন বা আবার দেখুন।"

msgid "Say why the decision is overturned (at least 10 characters)."
msgstr "সিদ্ধান্ত কেন বাতিল করা হচ্ছে লিখুন (অন্তত ১০ অক্ষর)।"

msgid "Too many verification emails for this account today. Try again later."
msgstr "আজ এই অ্যাকাউন্ট থেকে অনেক বেশি যাচাই ইমেইল পাঠানো হয়েছে। পরে আবার চেষ্টা করুন।"

msgid "Verification emails are paused for today. Try again tomorrow."
msgstr "আজকের মতো যাচাই ইমেইল পাঠানো বন্ধ আছে। আগামীকাল আবার চেষ্টা করুন।"

msgid ""
"This demo accepts only numbers that start with 010, which no real phone uses. "
"For example 01012345678."
msgstr ""
"এই ডেমোতে শুধু ০১০ দিয়ে শুরু নম্বর চলে, যা কোনো আসল ফোনে নেই। "
"যেমন 01012345678।"

msgid "Codes by SMS are paused for a short while. Try again later."
msgstr "এসএমএসে কোড পাঠানো কিছুক্ষণের জন্য বন্ধ আছে। পরে আবার চেষ্টা করুন।"
