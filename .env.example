# Copy to .env for local use: cp .env.example .env
# Every value here is a local-only placeholder. Production values live on the server, never in git.

DJANGO_SECRET_KEY=local-dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# Bootstrap superuser: used only to create the roles below on first start.
POSTGRES_DB=grs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local

# One role per kind of service (least privilege; timeouts are set on each role).
GRS_OWNER_PASSWORD=owner-local
GRS_API_PASSWORD=api-local
GRS_WORKER_PASSWORD=worker-local
GRS_REPLICATOR_PASSWORD=replicator-local
OWNER_DATABASE_URL=postgres://grs_owner:owner-local@postgres:5432/grs
API_DATABASE_URL=postgres://grs_api:api-local@postgres:5432/grs
WORKER_DATABASE_URL=postgres://grs_worker:worker-local@postgres:5432/grs

REDIS_BROKER_URL=redis://redis-broker:6379/0
REDIS_CACHE_URL=redis://redis-cache:6379/0

S3_ACCESS_KEY=grs-local
S3_SECRET_KEY=grs-local-secret
S3_BUCKET=attachments
# The API reaches storage inside Compose; upload/download links point where a client can reach.
S3_ENDPOINT=http://storage:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333

# Identity. Production generates its own; the prod settings refuse these placeholders.
JWT_SIGNING_KEYS=local1=local-dev-only-jwt-signing-key-not-secret
JWT_ACTIVE_KID=local1
# Fernet key (32 bytes, url-safe base64); this one decodes to "local-dev-only-not-a-secret-key!"
FIELD_ENCRYPTION_KEYS=bG9jYWwtZGV2LW9ubHktbm90LWEtc2VjcmV0LWtleSE=
# Accepts only +880 10 numbers and shows the fake SMS inbox at /api/v1/demo/sms/<phone>
DEMO_MODE=true

GUNICORN_WORKERS=2
LOG_LEVEL=INFO

# Attachments are checked by an EICAR stand-in. For real ClamAV: docker compose --profile full up -d
# ATTACHMENT_SCANNER=apps.collab.scanning.ClamdScanner

# Production only (deploy/scripts/gen-env.sh writes these on the server):
# GRS_DOMAIN=demo.example.org        # also serves files.<domain> and mail.<domain>
# LETSENCRYPT_EMAIL=you@example.org
# S3_AUDIT_BUCKET=audit-anchors      # copies of the audit chain's anchors
# REVIEW_SAMPLE_RATE=0.05            # share of resolutions sent for review
